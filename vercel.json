{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "other",
  "installCommand": "echo \"zen-proxy has no dependencies - skipping install\"",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index?__zp=/v1/:path*" },
    { "source": "/api/:path*", "destination": "/api/index?__zp=/api/:path*" },
    { "source": "/health", "destination": "/api/index?__zp=/health" }
  ]
}
