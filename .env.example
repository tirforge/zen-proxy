# zen-proxy — environment variables
# The names match the original zen-proxy env format. On Vercel, set these in
# Project Settings -> Environment Variables.

# Required on Vercel: without it /api and /v1 answer 503.
PROXY_KEY=change-me-to-a-long-random-string

# Required on Vercel: public URL of the Bun bridge (the bridge cannot run on
# Vercel, the free-tier gate refuses Node's TLS fingerprint).
BRIDGE_URL=https://bridge.example.com

# Recommended on Vercel: connect Vercel KV (Storage tab) or Upstash. With it,
# the dashboard's Save button persists — including the all-models toggle — so
# you never have to touch env vars again. Without it, saves last only for the
# life of the function instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash alternative (either pair works):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ZEN_PROXY_KV_KEY=zen-proxy:config

# All-models mode. This is only the FIRST-RUN default: once you flip the toggle
# in the dashboard, the stored value wins over this variable.
ALL_MODELS=1
ALL_MODELS_TARGET=nemotron-3.5-lightning-free

# Optional behaviour defaults (the dashboard overrides them once saved)
# DEFAULT_MODEL=beam-free
# FALLBACK_MODELS=["beam-free","deepseek-v4.1-flash-free"]
# MODEL_ALIASES={"gpt-4o":"beam-free"}
# RESPONSES_MODELS=["gpt-5*","gpt-6*","grok-*"]

# Local only
# HOST=127.0.0.1
# PORT=8787
# BRIDGE_DIR=bridge
# AUTO_START_BRIDGE=1
# ZEN_PROXY_CONFIG=zen-proxy.json
