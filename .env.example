# zen-proxy — Vercel environment variables
# Set these in Project Settings → Environment Variables. The names match the
# original zen-proxy env format.

# Required on Vercel: without it /api and /v1 answer 503.
PROXY_KEY=change-me-to-a-long-random-string

# Required on Vercel: public URL of the Bun bridge (the bridge cannot run on
# Vercel, the free-tier gate refuses Node's TLS fingerprint).
BRIDGE_URL=https://bridge.example.com

# All-models mode: accept any model id and any #effort suffix.
ALL_MODELS=1
ALL_MODELS_TARGET=nemotron-3.5-lightning-free

# Optional
# DEFAULT_MODEL=beam-free
# FALLBACK_MODELS=["beam-free","deepseek-v4.1-flash-free"]
# MODEL_ALIASES={"gpt-4o":"beam-free"}
# RESPONSES_MODELS=["gpt-5*","gpt-6*","grok-*"]
